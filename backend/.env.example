# Copie este arquivo para ".env" e ajuste os valores.

# Porta da API
PORT=3333

# Conexão com o PostgreSQL (troque SENHA pela senha do usuário postgres)
# O banco "chamados_ti" é criado automaticamente pelo comando: npm run db:setup
DATABASE_URL=postgres://postgres:SENHA@localhost:5432/chamados_ti

# Fuso horário usado nos relatórios e no "hoje" do painel
TIMEZONE=America/Sao_Paulo

# Segredo para assinar os tokens de login (use um texto longo e aleatório)
JWT_SECRET=troque-por-um-segredo-longo-e-aleatorio
